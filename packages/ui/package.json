{
  "name": "@kbach/ui",
  "version": "0.1.0-beta.4",
  "description": "Tailwind-like utility classes and components for React — web, React Native, and Expo",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/semsakadanupol/kbach.git",
    "directory": "packages/ui"
  },
  "homepage": "https://github.com/semsakadanupol/kbach#readme",
  "bugs": "https://github.com/semsakadanupol/kbach/issues",
  "source": "./src/index.ts",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "source": "./src/index.ts",
      "react-native": "./dist/index.js",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./jsx-runtime": {
      "types": "./dist/jsx-runtime.d.ts",
      "source": "./src/jsx-runtime.tsx",
      "import": "./dist/jsx-runtime.mjs",
      "require": "./dist/jsx-runtime.js"
    },
    "./jsx-dev-runtime": {
      "types": "./dist/jsx-dev-runtime.d.ts",
      "source": "./src/jsx-dev-runtime.tsx",
      "import": "./dist/jsx-dev-runtime.mjs",
      "require": "./dist/jsx-dev-runtime.js"
    },
    "./types": {
      "types": "./types.d.ts"
    },
    "./vite": {
      "types": "./dist/vite-plugin.d.ts",
      "source": "./src/vite-plugin.ts",
      "import": "./dist/vite-plugin.mjs",
      "require": "./dist/vite-plugin.js"
    },
    "./native": {
      "types": "./dist/native.d.ts",
      "source": "./src/native/index.ts",
      "import": "./dist/native.mjs",
      "require": "./dist/native.js"
    },
    "./babel": "./src/native/babel/index.js",
    "./babel-plugin": "./src/native/babel-plugin/index.js"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run --passWithNoTests",
    "lint": "tsc --noEmit",
    "postinstall": "node scripts/postinstall.js"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20.19.42",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.4",
    "jsdom": "^30.0.1",
    "react-dom": "^19.2.3",
    "tsup": "^8.0.0",
    "vite": "^5.4.21",
    "vitest": "^1.0.0"
  },
  "peerDependencies": {
    "@babel/core": "^7.0.0",
    "react": ">=18.0.0",
    "react-native": ">=0.70.0",
    "vite": ">=4.0.0"
  },
  "peerDependenciesMeta": {
    "@babel/core": {
      "optional": true
    },
    "react-native": {
      "optional": true
    },
    "vite": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "scripts",
    "src/native/babel-plugin",
    "src/native/babel",
    "types.d.ts",
    "jsx-runtime.js",
    "jsx-dev-runtime.js",
    "kbach-ui.md",
    "KBACH.md",
    "README.md"
  ]
}
