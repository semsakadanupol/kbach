{
  "name": "kbach-vscode",
  "displayName": "Kbach IntelliSense",
  "description": "className autocomplete, hover previews, and inline typo diagnostics for Kbach — the Rust-powered utility-class styling engine for React and React Native.",
  "version": "0.1.3",
  "publisher": "kbach",
  "icon": "images/icon.png",
  "galleryBanner": {
    "color": "#2e393f",
    "theme": "dark"
  },
  "preview": true,
  "license": "MIT",
  "homepage": "https://github.com/semsakadanupol/kbach/tree/main/packages/vscode-extension#readme",
  "bugs": {
    "url": "https://github.com/semsakadanupol/kbach/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/semsakadanupol/kbach.git",
    "directory": "packages/vscode-extension"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Linters",
    "Snippets"
  ],
  "keywords": [
    "kbach",
    "react",
    "react native",
    "expo",
    "css",
    "utility classes",
    "utility-first",
    "className",
    "autocomplete",
    "intellisense"
  ],
  "activationEvents": [
    "onLanguage:javascript",
    "onLanguage:javascriptreact",
    "onLanguage:typescript",
    "onLanguage:typescriptreact"
  ],
  "main": "./dist/extension.js",
  "contributes": {},
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsup && node scripts/copy-engine.mjs",
    "dev": "tsup --watch",
    "generate:vocabulary": "node scripts/generate-vocabulary.mjs src/generatedVocabulary.ts",
    "generate:colors": "node ../core-engine/scripts/generate-palette.mjs src/generatedPalette.ts",
    "test": "vitest run --passWithNoTests",
    "lint": "tsc --noEmit",
    "package": "node -e \"require('fs').copyFileSync('../../LICENSE','LICENSE')\" && npx @vscode/vsce package --no-dependencies",
    "publish:marketplace": "node -e \"require('fs').copyFileSync('../../LICENSE','LICENSE')\" && npx @vscode/vsce publish --no-dependencies"
  },
  "devDependencies": {
    "@kbach/core-engine": "1.0.0-beta.19",
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "tsup": "^8.0.0",
    "typescript": "^6.0.0",
    "vitest": "^1.0.0"
  }
}
