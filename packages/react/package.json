{
  "name": "@kbach/react",
  "version": "1.0.0-beta.20",
  "description": "A utility-first styling engine for React, powered by a real Rust/WASM core — Tailwind CSS v4 feature parity with Kbach's own color palette.",
  "keywords": [
    "css",
    "react",
    "tailwind",
    "utility-first",
    "wasm",
    "styling"
  ],
  "license": "MIT",
  "author": "semsakadanupol",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/semsakadanupol/kbach.git",
    "directory": "packages/react"
  },
  "homepage": "https://github.com/semsakadanupol/kbach#readme",
  "bugs": {
    "url": "https://github.com/semsakadanupol/kbach/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "source": "./src/index.ts",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "source": "./src/index.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./jsx-runtime": {
      "types": "./dist/jsx-runtime.d.ts",
      "source": "./src/jsx-runtime.tsx",
      "import": "./dist/jsx-runtime.mjs",
      "require": "./dist/jsx-runtime.js"
    },
    "./jsx-dev-runtime": {
      "types": "./dist/jsx-dev-runtime.d.ts",
      "source": "./src/jsx-dev-runtime.tsx",
      "import": "./dist/jsx-dev-runtime.mjs",
      "require": "./dist/jsx-dev-runtime.js"
    },
    "./vite": {
      "types": "./dist/vite-plugin.d.ts",
      "source": "./src/vite-plugin/index.ts",
      "import": "./dist/vite-plugin.mjs",
      "require": "./dist/vite-plugin.js"
    },
    "./postcss": {
      "types": "./dist/postcss-plugin.d.ts",
      "source": "./src/postcss-plugin/index.ts",
      "import": "./dist/postcss-plugin.mjs",
      "require": "./dist/postcss-plugin.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run --passWithNoTests",
    "test:coverage": "vitest run --coverage --passWithNoTests",
    "lint": "tsc --noEmit",
    "generate:colors": "node ../core-engine/scripts/generate-palette.mjs src/generatedPalette.ts"
  },
  "dependencies": {
    "@kbach/core-engine": "1.0.0-beta.11"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@vitest/coverage-v8": "^1.6.1",
    "jsdom": "^30.0.1",
    "postcss": "^8.4.0",
    "tsup": "^8.0.0",
    "typescript": "^6.0.0",
    "vite": "^5.4.21",
    "vitest": "^1.0.0"
  },
  "peerDependencies": {
    "postcss": "^8.0.0",
    "react": ">=18.0.0",
    "vite": ">=4.0.0"
  },
  "peerDependenciesMeta": {
    "postcss": {
      "optional": true
    },
    "vite": {
      "optional": true
    }
  }
}
