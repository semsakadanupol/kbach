node_modules/
dist/
coverage/
.turbo/
*.tsbuildinfo

# Rust
target/
dist-node/

# cargo's intermediate build dir, redirected here (via CARGO_BUILD_BUILD_DIR)
# to work around a Windows Application Control policy blocking build-script
# execution under %TEMP% on this machine.
.cargo-build-tmp/

# WASM build artifacts are committed via packages/core-engine/dist instead of
# the wasm-pack default output dir name (pkg/) — consumers (packages/react's
# jsx-runtime, the Vite plugin) import the built .js/.wasm directly, so a
# fresh clone needs it present without requiring a Rust toolchain + wasm-pack
# build step first. Negate the generic "dist/" rule above just for this path
# (both the directory and everything under it, per git's negation rules).
pkg/
!packages/core-engine/dist/
!packages/core-engine/dist/**

# Gradle build output for packages/react-native's bundled native module
# (apps/native-sandbox has its own RN-template .gitignore covering its app
# module already). "**/" prefix required — a bare "android/build/" in the
# root .gitignore anchors to the repo root and won't match the deeper
# packages/react-native/android/build/ path.
**/android/build/
**/android/.cxx/
**/android/.gradle/

# Eclipse/Buildship project metadata Gradle syncs auto-generate for any
# Android library module opened via Android Studio/Buildship tooling — not
# meant to be committed, same reasoning as the Gradle build output above.
**/android/.classpath
**/android/.project
**/android/.settings/
**/android/bin/

# Old all-TypeScript implementation, kept locally as a read-only reference
# during the from-scratch polyglot rewrite — not part of this repo's history.
old-kbach/

# packages/react's Vite plugin writes a generated, do-not-edit className
# type-hints file here (see vite-plugin/classNameHints.ts) — regenerated on
# every dev-server/build start, not meant to be committed or edited by hand.
.kbach/
