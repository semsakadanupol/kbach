{
  "name": "kbach",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/semsakadanupol/kbach.git"
  },
  "homepage": "https://github.com/semsakadanupol/kbach#readme",
  "bugs": "https://github.com/semsakadanupol/kbach/issues",
  "packageManager": "npm@11.13.0",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "clean": "turbo run clean && node -e \"require('fs').rmSync('node_modules',{recursive:true,force:true})\"",
    "publish:react": "turbo run build --filter=@kbach/react && npm version patch --workspace=@kbach/react --no-git-tag-version && npm publish --workspace=@kbach/react",
    "publish:all": "turbo run build && npm version patch --workspaces --no-git-tag-version && npm publish --workspaces"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/react": "^19.2.0",
    "turbo": "^2.0.0",
    "typescript": "^6.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
