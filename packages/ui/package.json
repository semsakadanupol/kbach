{
  "name": "@kbach/ui",
  "version": "1.0.0-beta.1",
  "description": "A tiny, dependency-free clsx-style className composer — join strings, arrays, and objects into one className, skipping anything falsy.",
  "keywords": ["css", "classnames", "clsx", "tailwind", "utility-first", "styling"],
  "license": "MIT",
  "author": "semsakadanupol",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/semsakadanupol/kbach.git",
    "directory": "packages/ui"
  },
  "homepage": "https://github.com/semsakadanupol/kbach#readme",
  "bugs": {
    "url": "https://github.com/semsakadanupol/kbach/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "files": ["dist"],
  "source": "./src/index.ts",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "source": "./src/index.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run --passWithNoTests",
    "lint": "tsc --noEmit"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^6.0.0",
    "vitest": "^1.0.0"
  }
}
