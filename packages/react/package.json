{
  "name": "@kbach/react",
  "version": "0.6.31",
  "description": "React / React Native components and hooks for the Kbach framework",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/semsakadanupol/kbach.git",
    "directory": "packages/react"
  },
  "homepage": "https://github.com/semsakadanupol/kbach#readme",
  "bugs": "https://github.com/semsakadanupol/kbach/issues",
  "source": "./src/index.ts",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "source": "./src/index.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./jsx-runtime": {
      "types": "./dist/jsx-runtime.d.ts",
      "source": "./src/jsx-runtime.tsx",
      "import": "./dist/jsx-runtime.mjs",
      "require": "./dist/jsx-runtime.js"
    },
    "./jsx-dev-runtime": {
      "types": "./dist/jsx-dev-runtime.d.ts",
      "source": "./src/jsx-dev-runtime.tsx",
      "import": "./dist/jsx-dev-runtime.mjs",
      "require": "./dist/jsx-dev-runtime.js"
    },
    "./types": {
      "types": "./types.d.ts"
    },
    "./vite": {
      "types": "./dist/vite-plugin.d.ts",
      "source": "./src/vite-plugin.ts",
      "import": "./dist/vite-plugin.mjs",
      "require": "./dist/vite-plugin.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run --passWithNoTests",
    "lint": "tsc --noEmit",
    "postinstall": "node scripts/postinstall.js"
  },
  "devDependencies": {
    "@types/node": "^20.19.42",
    "@types/react": "^19.2.0",
    "tsup": "^8.0.0",
    "vite": "^5.4.21",
    "vitest": "^1.0.0"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-native": ">=0.70.0",
    "vite": ">=4.0.0"
  },
  "peerDependenciesMeta": {
    "react-native": {
      "optional": true
    },
    "vite": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "scripts",
    "types.d.ts",
    "jsx-runtime.js",
    "jsx-dev-runtime.js",
    "kbach-react.md",
    "README.md"
  ]
}
